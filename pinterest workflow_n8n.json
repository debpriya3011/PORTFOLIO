    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pinterest-media-upload.s3-accelerate.amazonaws.com/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "x-amz-date",
              "value": "={{ $('Register Media Upload').item.json.upload_parameters['x-amz-date'] }}"
            },
            {
              "name": "x-amz-signature",
              "value": "={{ $('Register Media Upload').item.json.upload_parameters['x-amz-signature'] }}"
            },
            {
              "name": "x-amz-security-token",
              "value": "={{ $('Register Media Upload').item.json.upload_parameters['x-amz-security-token'] }}"
            },
            {
              "name": "x-amz-algorithm",
              "value": "={{ $('Register Media Upload').item.json.upload_parameters['x-amz-algorithm'] }}"
            },
            {
              "name": "key",
              "value": "={{ $('Register Media Upload').item.json.upload_parameters.key }}"
            },
            {
              "name": "policy",
              "value": "={{ $('Register Media Upload').item.json.upload_parameters.policy }}"
            },
            {
              "name": "x-amz-credential",
              "value": "={{ $('Register Media Upload').item.json.upload_parameters['x-amz-credential'] }}"
            },
            {
              "name": "Content-Type",
              "value": "multipart/form-data"
            },
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "=data"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        400,
        0
      ],
      "id": "51cd3322-b42f-4091-a9cb-8a663bf91647",
      "name": "Upload to AWS S3"
    },
    {
      "parameters": {
        "amount": 120
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        592,
        0
      ],
      "id": "711bb236-987a-4895-a159-ffce3b5d0659",
      "name": "Wait for Video Processing",
      "webhookId": "your-n8n-webhook-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.pinterest.com/v5/pins",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_PINTEREST_ACCESS_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"board_id\": \"YOUR_PINTEREST_BOARD_ID\",\n  \"media_source\": {\n\t\t\"cover_image_content_type\": \"image/jpeg\",\n    \"cover_image_url\": \"https://example.com/path/to/your-cover-image.jpg\",\n\t\t\n    \"media_id\": \"{{ $('Register Media Upload').item.json.media_id }}\",\n    \"source_type\": \"video_id\"\n  }\n}\n ",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        768,
        0
      ],
      "id": "a3d54dfc-f024-48c2-a8d5-00381413eaf2",
      "name": "Create Video Pin"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.pinterest.com/v5/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_PINTEREST_ACCESS_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"media_type\": \"video\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -80,
        -176
      ],
      "id": "3784fe01-eaac-4315-96de-16348237a162",
      "name": "Register Media Upload"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
